    int "SPI MOSI GPIO"
    range -1 54
    default -1

config ROBUSTO_HALOW_SPI_MISO_GPIO
    int "SPI MISO GPIO"
    range -1 54
    default -1

config ROBUSTO_HALOW_SPI_CS_GPIO
    int "SPI chip-select GPIO"
    range -1 54
    default -1

config ROBUSTO_HALOW_SPI_IRQ_GPIO
    int "Module interrupt GPIO"
    range -1 54
    default -1

config ROBUSTO_HALOW_SPI_DEBUG_RX_GPIO
    int "Module debug UART RX GPIO (diagnostics only)"
    range -1 54
    default -1
    help
        Connected to the module's debug TX, captured using UART2 at 115200.
        Not claimed unless detailed diagnostics are enabled. No UART TX.

config ROBUSTO_HALOW_SPI_DIAGNOSTICS
    bool "Enable detailed SPI startup diagnostics"
    default n
    help
        Capture SPI sequences, DMA backing memory, SDIO registers and
        receive-only module debug UART output. Diagnostic setup or DMA
        validation failures fail the operation. Disabled builds do not
        claim UART2 or require access to the SPI DMA descriptor.

config ROBUSTO_HALOW_RESET_AFTER_START
    bool "Request one module reset/reinitialization after HaLow startup"
    default n
    help
        Invoke the explicit reset API once after the initial HaLow start,
        whether it succeeded or failed. This requests a HaLow module reboot,
        not an ESP32 reboot or factory reset. Failures are logged without
        retries. Disabled by default; manual reset remains available.

endif

endmenu
